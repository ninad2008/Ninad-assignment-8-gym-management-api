              "raw": "http://localhost:5000/api/classes/{{classId}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "classes", "{{classId}}"]
            }
          }
        },
        {
          "name": "Book Class",
          "request": {
            "method": "POST",
            "header": [],
