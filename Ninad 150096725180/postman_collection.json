    {
      "name": "2. Fitness Classes",
      "item": [
        {
          "name": "Get All Upcoming Classes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/classes",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "classes"]
            }
          }
        },
        {
          "name": "Filter Classes by Trainer",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/classes?trainer=Marcus",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "classes"],
              "query": [
                {
                  "key": "trainer",
                  "value": "Marcus"
                }
              ]
            }
          }
        },
        {
          "name": "Create Class (Capacity 2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"HIIT Bootcamp\",\n  \"trainerName\": \"Marcus Vance\",\n  \"scheduleDate\": \"2026-04-15T09:00:00Z\",\n  \"durationMinutes\": 45,\n  \"maxCapacity\": 2\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/classes",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "classes"]
            }
          }
        },
        {
          "name": "Get Class By ID",
          "request": {
            "method": "GET",
            "header": [],
